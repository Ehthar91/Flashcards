rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function classExists(classId) {
      return exists(/databases/$(database)/documents/classes/$(classId));
    }

    function ownsClass(classId) {
      return signedIn()
        && classExists(classId)
        && get(/databases/$(database)/documents/classes/$(classId)).data.ownerId == request.auth.uid;
    }

    function publishedClass(classId) {
      return classExists(classId)
        && get(/databases/$(database)/documents/classes/$(classId)).data.published == true;
    }

    function followsClass(classId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/library/$(classId));
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;

      match /library/{classId} {
        allow read: if signedIn() && request.auth.uid == uid;

        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.classId == classId
          && request.resource.data.access == "study"
          && publishedClass(classId);

        allow update: if signedIn()
          && request.auth.uid == uid
          && resource.data.classId == classId
          && request.resource.data.classId == classId
          && request.resource.data.access == "study";

        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /classes/{classId} {
      // Published classes can be opened from their exact share link.
      // Owners can always access their own class.
      allow get: if resource.data.published == true
        || (signedIn() && resource.data.ownerId == request.auth.uid);

      // Used by the owner's "My Classes" query.
      allow list: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      match /decks/{deckId} {
        // Owners can read/edit all decks.
        // Followers can read decks while the parent class remains published.
        allow get, list: if ownsClass(classId)
          || (publishedClass(classId) && followsClass(classId));

        allow create, update, delete: if ownsClass(classId);
      }
    }

    match /progress/{progressId} {
      allow get: if signedIn() && (
        resource.data.studentId == request.auth.uid
        || ownsClass(resource.data.classId)
      );

      // Student query must constrain studentId to request.auth.uid.
      // Owner learner query must constrain classId to a class they own.
      allow list: if signedIn() && (
        resource.data.studentId == request.auth.uid
        || ownsClass(resource.data.classId)
      );

      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && (
          ownsClass(request.resource.data.classId)
          || (
            publishedClass(request.resource.data.classId)
            && followsClass(request.resource.data.classId)
          )
        );

      allow update: if signedIn()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.deckId == resource.data.deckId;

      allow delete: if signedIn()
        && resource.data.studentId == request.auth.uid;
    }
  }
}
