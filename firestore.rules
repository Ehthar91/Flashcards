rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsDeck(deckId) {
      return signedIn()
        && exists(/databases/$(database)/documents/decks/$(deckId))
        && get(/databases/$(database)/documents/decks/$(deckId)).data.ownerId == request.auth.uid;
    }

    function publishedDeck(deckId) {
      return exists(/databases/$(database)/documents/decks/$(deckId))
        && get(/databases/$(database)/documents/decks/$(deckId)).data.published == true;
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;

      match /library/{deckId} {
        allow read: if signedIn() && request.auth.uid == uid;

        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.deckId == deckId
          && request.resource.data.access == "study"
          && publishedDeck(deckId);

        allow update: if signedIn()
          && request.auth.uid == uid
          && resource.data.deckId == deckId
          && request.resource.data.deckId == deckId
          && request.resource.data.access == "study";

        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /decks/{deckId} {
      // Anyone with the exact link can open a published deck.
      allow get: if resource.data.published == true
        || (signedIn() && resource.data.ownerId == request.auth.uid);

      // Listing is only useful for the owner's query:
      // where("ownerId", "==", request.auth.uid)
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /progress/{progressId} {
      allow get: if signedIn() && (
        resource.data.studentId == request.auth.uid
        || ownsDeck(resource.data.deckId)
      );

      // Students may query only their own progress.
      // Deck owners may query progress for decks they own.
      allow list: if signedIn() && (
        resource.data.studentId == request.auth.uid
        || ownsDeck(resource.data.deckId)
      );

      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && (
          publishedDeck(request.resource.data.deckId)
          || ownsDeck(request.resource.data.deckId)
        );

      allow update: if signedIn()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.deckId == resource.data.deckId;

      allow delete: if false;
    }
  }
}
