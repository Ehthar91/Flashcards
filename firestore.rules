rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function ownsDeck(deckId) {
      return isAdmin() &&
        get(/databases/$(database)/documents/decks/$(deckId)).data.createdBy == request.auth.uid;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /decks/{deckId} {
      // Published decks are readable by anyone with the link.
      allow get: if resource.data.published == true ||
        (isAdmin() && resource.data.createdBy == request.auth.uid);

      // Only admins can list decks, and queries must only return their own decks.
      allow list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if isAdmin()
        && resource.data.createdBy == request.auth.uid;
    }

    match /progress/{progressId} {
      allow get: if signedIn() && (
        resource.data.studentId == request.auth.uid ||
        ownsDeck(resource.data.deckId)
      );

      allow list: if signedIn() && (
        resource.data.studentId == request.auth.uid ||
        ownsDeck(resource.data.deckId)
      );

      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && get(/databases/$(database)/documents/decks/$(request.resource.data.deckId)).data.published == true;

      allow update: if signedIn()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.deckId == resource.data.deckId;

      allow delete: if false;
    }
  }
}
